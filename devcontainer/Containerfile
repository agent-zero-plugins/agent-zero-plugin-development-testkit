# Agent Zero plugin devkit — unified execution environment.
#
# One image, three uses (SPEC DEC-018): CI runner, developer dev container,
# AI-agent local env. It boots the Agent Zero container *nested and
# unprivileged* via rootless podman — no --privileged, no host docker.sock.
#
# BASE CHOICE (Phase-0 spike finding, 2026-06-19):
#   The obvious base — the official Playwright image (Ubuntu jammy) + apt
#   `podman` — FAILS to nest rootlessly: jammy ships podman 3.4.4, and nested
#   rootless `podman run` dies with "cannot setup namespace using newuidmap".
#   quay.io/podman/stable (modern podman, purpose-built + pre-configured for
#   rootless nesting) WORKS. So we base on it and add the harness tooling.
#
#   Trade-off: it's Fedora-based, so Playwright browser system-deps are a
#   Phase-1 addition (Playwright's `--with-deps` is Debian/Ubuntu-only; on
#   Fedora the deps are installed explicitly). The Phase-0 GATE is *nesting*,
#   which needs no browser — so the spike image carries only what the
#   acceptance needs (podman + curl). Node/Playwright land in Phase 1.

FROM quay.io/podman/stable

# Harness tooling. podman + fuse-overlayfs + rootless plumbing already ship in
# this base. Add curl/jq + Node + Playwright + Chromium with its Fedora system
# libs (Playwright's `install-deps` is Debian-only, so we list Fedora pkgs).
ARG PLAYWRIGHT_VERSION=1.48.0
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN dnf install -y \
      curl jq zip unzip diffutils nodejs npm \
      nss nspr atk at-spi2-atk at-spi2-core cups-libs libdrm libxkbcommon \
      libXcomposite libXdamage libXext libXfixes libXrandr libXcursor libXi libXtst \
      libX11 libxcb mesa-libgbm pango cairo alsa-lib dbus-libs expat \
 && dnf clean all \
 && npm install -g "playwright@${PLAYWRIGHT_VERSION}" "@playwright/test@${PLAYWRIGHT_VERSION}" \
 && npx --yes "playwright@${PLAYWRIGHT_VERSION}" install chromium \
 && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
 && echo "export NODE_PATH=$(npm root -g)" > /etc/profile.d/node_path.sh

# The base ships an unprivileged `podman` user with a working subuid/subgid
# range and newuidmap/newgidmap caps — the exact setup the Ubuntu path lacked.
USER podman
ENV NODE_PATH=/usr/lib/node_modules
WORKDIR /workspace

# Sanity: report the (modern) podman this base provides.
RUN podman --version

ENTRYPOINT ["/bin/bash"]
