# Devkit common targets (SPEC Appendix E.1) — the template-method skeleton.
#
# A consumer plugin repo sets a few vars and `-include`s this fragment. Every
# plugin gets the same build/package/up/down/e2e interface; the ONLY per-plugin
# variant is the verify-installed / verify-uninstalled hooks under
# tests/e2e/hooks/ (Appendix E.4).
#
#   # in the plugin repo's Makefile, before the include:
#   PLUGIN_DIR          := usr/plugins/my_plugin     # dir containing plugin.yaml
#   PLUGIN_DISPLAY_NAME := My Plugin                 # title on the plugin card
#   -include tests/_testkit/e2e/Makefile.devkit
#
# Override-able knobs:
DEVKIT_IMAGE ?= ghcr.io/agent-zero-plugins/plugin-devkit:latest
# A0_IMAGE: DEC-019, per-plugin overridable. DEVKIT_DIR: where the devkit is vendored.
# (No inline comments on these assignments — Make would fold the trailing spaces
#  into the value and break $(VAR)/path concatenation.)
A0_IMAGE     ?= docker.io/agent0ai/agent-zero:latest
DEVKIT_DIR   ?= tests/_testkit
PLUGIN_DIR   ?= .
DIST_DIR     ?= dist
PLUGIN_NAME  ?= $(shell sed -nE 's/^name:[[:space:]]*"?([A-Za-z0-9_-]+)"?.*/\1/p' $(PLUGIN_DIR)/plugin.yaml 2>/dev/null | head -1)
PLUGIN_ZIP   ?= $(DIST_DIR)/$(PLUGIN_NAME).zip

# Rootless nested-container flags proven in Phase 0 (no --privileged, no docker.sock).
PODMAN_E2E_FLAGS := --rm --device /dev/fuse --security-opt label=disable \
  --sysctl net.ipv4.ip_unprivileged_port_start=0

# BDD verification targets (make verify / bdd-lint / install-hooks) — DEC-066.
# Riding along here means the standard one-line include gives them for free.
-include $(DEVKIT_DIR)/e2e/make/bdd.mk

.PHONY: build package up down e2e conformance update-devkit link-workflows link-gemini link-skills link-devkit sync-skills help-devkit

# Which devkit ref to bump to. Empty (default) = the latest release tag (vetted);
# override for a specific release or bleeding edge:  make update-devkit DEVKIT_REF=v1.2.0
#                                                     make update-devkit DEVKIT_REF=main
DEVKIT_REF ?=

update-devkit: ## bump the vendored devkit to the latest release tag (or DEVKIT_REF) + re-copy assets
	@git -C $(DEVKIT_DIR) fetch -q --tags --force origin
	@ref="$(DEVKIT_REF)"; \
	 [ -n "$$ref" ] || ref=$$(git -C $(DEVKIT_DIR) tag -l 'v*' --sort=-v:refname | head -1); \
	 [ -n "$$ref" ] || { echo "[devkit] no release tags yet — falling back to main"; ref=main; git -C $(DEVKIT_DIR) fetch -q origin main; }; \
	 git -C $(DEVKIT_DIR) checkout -q --detach "$$ref" 2>/dev/null || git -C $(DEVKIT_DIR) checkout -q --detach FETCH_HEAD; \
	 git add $(DEVKIT_DIR); \
	 $(MAKE) --no-print-directory link-devkit; \
	 echo "[devkit] bumped $(DEVKIT_DIR) → $$ref ($$(git -C $(DEVKIT_DIR) rev-parse --short HEAD)) + re-linked root assets."; \
	 echo "[devkit] review, then commit: git commit -m 'chore: bump devkit to '$$ref"

link-devkit: link-workflows link-gemini link-skills ## copy/symlink ALL devkit-shipped assets into this repo (DEC-044/066/068)
	@echo "[devkit] linked workflows + .gemini + skills — commit them once."

link-skills: ## symlink the devkit's plugin-facing skills into .claude/skills/ (auto-fresh on devkit bump)
	@if [ -d $(DEVKIT_DIR)/skills ]; then \
	  mkdir -p .claude/skills; \
	  for s in $(DEVKIT_DIR)/skills/*/; do n=$$(basename "$$s"); \
	    ln -sfn "../../$(DEVKIT_DIR)/skills/$$n" ".claude/skills/$$n"; done; \
	  echo "[skills] symlinked $(DEVKIT_DIR)/skills/* → .claude/skills/ (Claude Code / Copilot / Antigravity)"; \
	else echo "[skills] no skills/ in the devkit ref — skipping"; fi

sync-skills: ## (maintainer, in the DEVKIT repo) refresh skills/ from an operator-skills checkout: make sync-skills SKILLS_SRC=/path/to/agent-zero-operator-skills
	@[ -n "$(SKILLS_SRC)" ] || { echo "set SKILLS_SRC=/path/to/agent-zero-operator-skills"; exit 1; }
	@for d in skills/*/; do n=$$(basename "$$d"); \
	  src=$$(find "$(SKILLS_SRC)/shared-assets/skills" -type d -name "$$n" 2>/dev/null | head -1); \
	  if [ -n "$$src" ]; then rm -rf "$$d"; cp -r "$$src" "skills/$$n"; echo "  refreshed skills/$$n"; \
	  else echo "  skills/$$n — not in operator-skills (devkit-owned; left as-is)"; fi; done
	@echo "[skills] refreshed from $(SKILLS_SRC) — review + commit before cutting a release."

link-workflows: ## copy the devkit-sync + plugin-e2e caller workflows into .github/workflows/ (DEC-044)
	@if [ -d $(DEVKIT_DIR)/templates ]; then \
	  mkdir -p .github/workflows; \
	  cp $(DEVKIT_DIR)/templates/devkit-sync.caller.yml .github/workflows/devkit-sync.yml; \
	  cp $(DEVKIT_DIR)/templates/plugin-e2e.caller.yml .github/workflows/plugin-e2e.yml; \
	  echo "[wf] linked devkit-sync.yml + plugin-e2e.yml → .github/workflows/ (commit once)"; \
	else echo "[wf] no templates/ in the devkit ref — skipping"; fi

link-gemini: ## copy the .gemini AI-reviewer styleguide into this repo (DEC-066)
	@if [ -d $(DEVKIT_DIR)/.gemini ]; then \
	  mkdir -p .gemini; \
	  cp $(DEVKIT_DIR)/.gemini/config.yaml .gemini/config.yaml; \
	  cp $(DEVKIT_DIR)/.gemini/styleguide.md .gemini/styleguide.md; \
	  echo "[gemini] linked .gemini/{config.yaml,styleguide.md} (commit once; Gemini Code Assist enforces the gates)"; \
	else echo "[gemini] no .gemini in the devkit ref — skipping"; fi

build: ## assemble the plugin dir (no-op for source-only plugins)
	@echo "build: nothing to assemble for '$(PLUGIN_NAME)'"

package: ## produce the versioned plugin zip from $(PLUGIN_DIR)
	@mkdir -p $(DIST_DIR)
	@rm -f $(PLUGIN_ZIP)
	cd $(PLUGIN_DIR) && zip -qr $(abspath $(PLUGIN_ZIP)) . -x '*.DS_Store' 'tests/*' '.github/*' '*/node_modules/*'
	@echo "packaged → $(PLUGIN_ZIP)"

e2e: package ## behaviour BDD if tests/e2e/features/ exists, else classic lifecycle — in the devcontainer
	@harness=run-lifecycle.sh; \
	ls $(PLUGIN_DIR)/tests/e2e/features/*.feature >/dev/null 2>&1 && harness=run-bdd.sh; \
	pod_env=$$(awk '\
	  /^e2e_pod_env:[[:space:]]*$$/ {inblk=1; next} \
	  inblk && /^[[:space:]]+[A-Za-z_][A-Za-z0-9_]*:/ { l=$$0; sub(/^[[:space:]]+/,"",l); \
	    k=l; sub(/:.*/,"",k); v=l; sub(/^[^:]*:[[:space:]]*/,"",v); gsub(/^["'\'']|["'\'']$$/,"",v); \
	    printf "%s=%s ", k, v; next } \
	  inblk && /^[^[:space:]]/ {inblk=0}' .devkit.yml 2>/dev/null); \
	echo "[e2e] harness=$$harness  pod_env=[$$pod_env]"; \
	podman run $(PODMAN_E2E_FLAGS) \
	  -v $(CURDIR):/workspace:ro \
	  -v $(abspath $(PLUGIN_ZIP)):/tmp/plugin.zip:ro \
	  -e A0_IMAGE=$(A0_IMAGE) \
	  -e PLUGIN_ZIP=/tmp/plugin.zip \
	  -e PLUGIN_DISPLAY_NAME="$(PLUGIN_DISPLAY_NAME)" \
	  -e PLUGIN_NAME=$(PLUGIN_NAME) \
	  -e HOOK_DIR=/workspace/tests/e2e/hooks \
	  -e WORKSPACE=/workspace \
	  -e DEVKIT_PATH=$(DEVKIT_DIR) \
	  -e A0_POD_ENV="$$pod_env" \
	  $(DEVKIT_IMAGE) -lc "bash /workspace/$(DEVKIT_DIR)/e2e/harness/$$harness"

up: ## boot A0 nested for manual/agent exploration (inside the devcontainer)
	podman run $(PODMAN_E2E_FLAGS) -it \
	  -v $(CURDIR):/workspace:ro -e A0_IMAGE=$(A0_IMAGE) \
	  $(DEVKIT_IMAGE) -lc 'bash /workspace/$(DEVKIT_DIR)/e2e/harness/a0-up.sh && echo "A0 on :80 — exec in to explore" && sleep infinity'

conformance: ## assert this repo exposes the frozen target set + allowed assets
	@for t in build package up e2e; do \
	  $(MAKE) -n $$t >/dev/null 2>&1 || { echo "missing target: $$t"; exit 1; }; \
	done
	@test -f tests/e2e/hooks/verify-installed || echo "note: no tests/e2e/hooks/verify-installed (optional)"
	@echo "conformance OK"
